    <style name="Base.AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <!-- 系统栏：半透明磨砂 -->
        <item name="android:statusBarColor">@color/glass_light_40</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/glass_light_50</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- 启用背景模糊（Android 12+ 支持） -->
        <item name="android:windowBackgroundBlurRadius" tools:targetApi="31">30dp</item>
        <item name="android:windowIsTranslucent">false</item>
        <!-- 全局背景 - 柔和渐变底 -->
        <item name="android:windowBackground">@drawable/bg_window_gradient</item>

        <!-- Material 颜色映射（浅色基线：避免未叠加 overlay 的页面(登录/启动)落到 Material3 默认紫） -->
