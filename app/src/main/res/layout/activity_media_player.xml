<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!--
      ExoPlayer 渲染面（Media3 统一内核）。
      use_controller=false：控制条沿用页面自己那套（player_controls），
      否则会与内置控制器叠两层 UI。
      id 保持 video_view 不变，避免动 Java 侧的一堆 findViewById。
    -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        app:resize_mode="fit"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <!-- 音频播放时的占位（无画面，用此替代黑屏） -->
    <LinearLayout
        android:id="@+id/audio_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_audio"
            android:alpha="0.9"
            android:contentDescription="音频"
            android:tint="#42A5F5" />

        <TextView
            android:id="@+id/tv_audio_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:maxWidth="300dp"
            android:gravity="center"
            android:ellipsize="middle"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="音频播放中"
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 播放错误浮层：内嵌在播放器内部显示（用户要求不要用弹出的界面） -->
    <LinearLayout
        android:id="@+id/player_error_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="无法播放"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_player_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_player_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#33FFFFFF"
            android:paddingHorizontal="22dp"
            android:paddingVertical="9dp"
            android:text="重试"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 顶部：返回 + 文件名 -->
    <LinearLayout
        android:id="@+id/player_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/btn_player_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="返回"
            android:padding="8dp"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tv_player_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text=""
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_player_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 底部控制区：上排「时间 + 进度」，下排「控制键居中 + 左下角列表」 -->
    <LinearLayout
        android:id="@+id/player_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <!-- 第一行：时间与进度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_player_pos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seek_player"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="10dp" />

            <TextView
                android:id="@+id/tv_player_dur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 第二行：控制键整体居中；左下角另有「选择文件」按钮 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_player_prev"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_skip_previous"
                    android:contentDescription="上一个"
                    android:padding="9dp"
                    android:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/btn_player_play"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="18dp"
                    android:src="@drawable/ic_pause"
                    android:contentDescription="播放/暂停"
                    android:padding="10dp"
                    android:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/btn_player_next"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_skip_next"
                    android:contentDescription="下一个"
                    android:padding="9dp"
                    android:tint="#FFFFFF" />
            </LinearLayout>

            <!-- 右下角：倍速 / 画面比例（文字按钮，省去新图标；对齐 Kazumi 的播放器控制项） -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_player_episodes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="#22FFFFFF"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="选集"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btn_player_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#22FFFFFF"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="1.0×"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_player_ratio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="#22FFFFFF"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="适应"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 左下角：选择当前目录的音视频文件 -->
            <ImageView
                android:id="@+id/btn_player_list"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="start|center_vertical"
                android:src="@drawable/ic_menu"
                android:contentDescription="选择文件"
                android:padding="9dp"
                android:tint="#FFFFFF" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
