<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/about_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ══ 应用标识 ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="66dp"
                android:layout_height="66dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorPrimaryContainer">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="应用图标"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HY_VQ"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tv_about_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="v1.4.0"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="4dp"
            android:text="极简高效的 Android 文件管理与连接工具。\n本软件以 GNU GPL v3.0 协议开源。"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- ══ 开源 ══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="4dp"
            android:text="开源"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorPrimary" />

        <LinearLayout
            android:id="@+id/item_about_repo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="13dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp" android:layout_height="40dp"
                app:cardCornerRadius="12dp" app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorPrimaryContainer">
                <ImageView
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/ic_network"
                    android:contentDescription="开源仓库"
                    android:padding="9dp"
                    app:tint="?attr/colorPrimary" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="14dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="开源仓库"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface" />
                <TextView
                    android:id="@+id/tv_about_repo"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="github.com/haoyou999/HY_VQ"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="打开" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item_about_license"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="13dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp" android:layout_height="40dp"
                app:cardCornerRadius="12dp" app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSecondaryContainer">
                <ImageView
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/ic_doc"
                    android:contentDescription="开源许可证"
                    android:padding="9dp"
                    app:tint="?attr/colorOnSecondaryContainer" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="14dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="开源许可证"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="GNU General Public License v3.0"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="查看" />
        </LinearLayout>

        <!-- ══ 支持 ══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="4dp"
            android:text="支持"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorPrimary" />

        <LinearLayout
            android:id="@+id/item_about_changelog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="13dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp" android:layout_height="40dp"
                app:cardCornerRadius="12dp" app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorTertiaryContainer">
                <ImageView
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/ic_refresh"
                    android:contentDescription="检查更新"
                    android:padding="9dp"
                    app:tint="?attr/colorTertiary" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="14dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="检查更新"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="联网获取最新版本与更新日志"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="检查" />
        </LinearLayout>


        <!-- ══ 致谢（点击打开独立弹窗，分引用/借鉴/历史三板块） ══ -->
        <LinearLayout
            android:id="@+id/item_about_credits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="13dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp" android:layout_height="40dp"
                app:cardCornerRadius="12dp" app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSecondaryContainer">
                <ImageView
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/ic_star"
                    android:contentDescription="致谢"
                    android:padding="9dp"
                    app:tint="?attr/colorSecondary" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="14dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="致谢"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface" />
                <TextView
                    android:id="@+id/tv_about_credits"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="引用的开源库、借鉴的设计与历史参考"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="查看" />
        </LinearLayout>

        
        <!-- ══ 声明 ══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp"
            android:text="声明"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorError" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorError"
            app:cardBackgroundColor="?attr/colorErrorContainer">

            <TextView
                android:id="@+id/tv_about_disclaimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:lineSpacingExtra="4dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnErrorContainer" />
        </com.google.android.material.card.MaterialCardView>

<!-- ══ 支持开发（v2.9.4：只放一个按钮，点开才在弹窗里显示收款码；不主动提醒） ══ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_support_dev"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:minHeight="40dp"
            android:text="支持开发"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:strokeColor="?attr/colorOutlineVariant" />

<!-- ══ 反馈渠道（邮箱 / QQ群 / QQ私人）—— 点击复制 ══ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

            <LinearLayout
                android:id="@+id/box_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="反馈渠道"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tv_feedback_mail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="邮箱　3077094639@qq.com"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorPrimary"
                    android:background="?attr/selectableItemBackground" />

                <TextView
                    android:id="@+id/tv_feedback_qq_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="QQ 群　119544089"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorPrimary"
                    android:background="?attr/selectableItemBackground" />

                <TextView
                    android:id="@+id/tv_feedback_qq_private"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="QQ 私聊　3077094639"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorPrimary"
                    android:background="?attr/selectableItemBackground" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="点击任意一行可复制"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

<!-- ══ 版权 ══ -->
        <TextView
            android:id="@+id/tv_about_copyright"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>
</ScrollView>
